# Dockerfile.gpu
# ---------------
# CUDA-enabled container for deploying the image filter pipeline on
# a cloud GPU instance (AWS p3/g4, GCP a2/g2, Azure NC-series, etc.).
#
# Uses NVIDIA's official CUDA base image, which includes the CUDA runtime,
# nvcc compiler, and GPU libraries. At deploy time, the host machine must
# have an NVIDIA GPU with the nvidia-container-toolkit installed.
#
# Build:   docker build -f Dockerfile.gpu -t hpc-filter-gpu .
# Run:     docker run --gpus all -p 5000:5000 hpc-filter-gpu
#
# This Dockerfile demonstrates a production-ready GPU deployment pipeline
# for cloud platforms (Unit 4 — Cloud Deployment).

FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

# Install gcc (for serial/OpenMP), Python, and OpenMP runtime
RUN apt-get update && \
    apt-get install -y gcc libgomp1 python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy all project files
COPY . .

# Compile all three filter implementations inside the container:
#   - Serial (gcc, no parallelism)
#   - OpenMP (gcc with -fopenmp, CPU multi-threading)
#   - CUDA   (nvcc, GPU execution)
RUN gcc -O2 -o serial_filter serial_filter.c -lm && \
    gcc -O2 -fopenmp -o openmp_filter openmp_filter.c -lm && \
    nvcc -O2 -o cuda_filter cuda_filter.cu

# Install Python dependencies
RUN pip3 install --no-cache-dir flask gunicorn

# The GPU-enabled app supports serial, openmp, AND cuda methods
# Expose port 5000 for the Flask API
EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "cloud_gpu_app:app"]
